{
  "openapi": "3.0.0",
  "info": { "title": "Restaurant Requests", "version": "1.0.0" },
  "paths": {
    "/api/restaurant-requests": {
      "post": {
        "summary": "Public create (rate-limited 20/hour)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customerName", "restaurantName", "phone", "whatsapp"],
                "properties": {
                  "customerName": { "type": "string", "minLength": 2, "maxLength": 80 },
                  "restaurantName": { "type": "string", "minLength": 2, "maxLength": 80 },
                  "phone": { "type": "string", "minLength": 7, "maxLength": 20 },
                  "whatsapp": { "type": "string", "minLength": 7, "maxLength": 20 },
                  "city": { "type": "string", "maxLength": 60 },
                  "notes": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created {ok:true, request:{id,code}}" },
          "400": { "description": "Validation BAD_REQUEST, no row" },
          "429": { "description": "RATE_LIMITED" }
        }
      }
    },
    "/api/owner/restaurant-requests": {
      "get": {
        "summary": "Owner list (requireOwner)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "enum": ["pending", "contacted", "approved", "rejected"] } }
        ],
        "responses": {
          "200": { "description": "{total,page,limit,requests[]}" },
          "401": { "description": "UNAUTHORIZED" },
          "403": { "description": "FORBIDDEN non-owner" }
        }
      }
    },
    "/api/owner/restaurant-requests/{id}": {
      "patch": {
        "summary": "Owner set status",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["pending", "contacted", "approved", "rejected"] } } } } } },
        "responses": { "200": { "description": "{request}" }, "404": { "description": "Not found" } }
      },
      "delete": {
        "summary": "Owner delete",
        "responses": { "200": { "description": "{ok:true}" } }
      }
    }
  }
}
